---
/**
 * Секция 03 — анатомия. Источник названий: src/data/parts.ts.
 * Модель: GLB из Blender (tools/blender/build.py), разборка по кнопке.
 * Без WebGL или при prefers-reduced-motion: рендер-кадр и список узлов.
 */
import Arrow from '../Arrow.astro';
import { ANATOMY, PARTS } from '../../data/parts';

const CHECKS = [
  { id: 'power', name: 'Питание и плата' },
  { id: 'heat', name: 'Нагрев бойлера' },
  { id: 'pump', name: 'Помпа и давление' },
  { id: 'group', name: 'Пролив группы' },
  { id: 'steam', name: 'Паровой клапан' },
  { id: 'scale', name: 'Накипь в контуре' },
] as const;
---

<section class="sec anatomy" id="anatomy" aria-labelledby="anatomy-title">
  <div class="shell sec__inner anatomy__head">
    <div class="sec__num">{ANATOMY.n}</div>

    <div class="anatomy__head-row">
      <h2 class="h2" id="anatomy-title">{ANATOMY.title}</h2>
      <p class="anatomy__hint mono">
        Крутите · приближайте · разбирайте
        <Arrow size={14} />
      </p>
    </div>
  </div>

  <div class="anatomy__viewer" data-viewer-root>
    <div class="anatomy__stage" data-viewer-stage>
      <canvas class="anatomy__canvas" data-viewer-canvas aria-label="Трёхмерная модель кофемашины"></canvas>
      <img
        class="anatomy__poster"
        src={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}img/model-still.png`}
        width="1200"
        height="1200"
        alt="Корпус кофемашины в разрезе: варочная группа, бойлер, помпа, бак для воды"
        loading="lazy"
        decoding="async"
      />
      <div class="anatomy__labels" data-viewer-labels></div>
    </div>

    <div class="anatomy__bar">
      <p class="anatomy__legend mono">Выберите деталь и разберите машину</p>
      <button class="anatomy__toggle mono" type="button" data-viewer-toggle aria-pressed="false" disabled>
        Разобрать
      </button>
      <p class="anatomy__hint-mono mono">Мышью — поворот · колесо — масштаб</p>
    </div>

    <aside class="diag" data-diag aria-labelledby="diag-title">
      <div class="diag__head">
        <p class="mono diag__title" id="diag-title">Самодиагностика</p>
        <span class="mono diag__seq">SEQ 01</span>
      </div>

      <ul class="diag__list">
        {CHECKS.map((c) => (
          <li class="diag__row" data-diag-row={c.id}>
            <span class="diag__dot" aria-hidden="true"></span>
            <span class="diag__name">{c.name}</span>
            <span class="diag__val mono" data-diag-val>—</span>
          </li>
        ))}
      </ul>

      <button class="diag__run mono" type="button" data-diag-run disabled>
        Запустить диагностику
      </button>

      <p class="diag__note">
        Тест безопасен: вода идёт в поддон, пар — вхолостую. Так же проходит приёмка и после ремонта.
      </p>

      <a class="diag__cta" href="#contact" data-diag-cta hidden>
        Так же починим и вашу <Arrow size={14} />
      </a>
    </aside>
  </div>

  <div class="shell">
    <ol class="anatomy__list">
      {PARTS.map((part, i) => (
        <li class="anatomy__list-item">
          <span class="mono anatomy__list-idx">{String(i + 1).padStart(2, '0')}</span>
          <span>{part.name}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { initViewer } from '../../scenes/viewer';

  type Api = { explode: (on: boolean) => void; isExploded: () => boolean; pulse: (n: string) => void };

  const root = document.querySelector<HTMLElement>('[data-viewer-root]');
  if (root) initViewer(root);

  const panel = root?.querySelector<HTMLElement>('[data-diag]');
  const runBtn = panel?.querySelector<HTMLButtonElement>('[data-diag-run]');
  const cta = panel?.querySelector<HTMLElement>('[data-diag-cta]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-viewer-toggle]');
  const api = root ? (root as HTMLElement & { __viewer?: Api }).__viewer : undefined;

  const OK: Record<string, string> = {
    power: 'ok',
    heat: '93 °C',
    pump: '9.2 бар',
    group: '30 мл',
    steam: 'ok',
    scale: '4 %',
  };

  // Неисправность берётся заново на каждый прогон — демо не повторяется
  const FAULTS = [
    { row: 'scale', bad: '62 %', node: 'Бойлер', fix: 'Накипь снята, контур промыт.' },
    { row: 'pump', bad: '7.1 бар', node: 'Помпа', fix: 'Клапан помпы заменён.' },
    { row: 'group', bad: '0.4 бар', node: 'Варочная группа', fix: 'Прокладка и сетка заменены.' },
    { row: 'steam', bad: '28 %', node: 'Паровой кран', fix: 'Нарост снят, клапан отрегулирован.' },
  ];

  if (panel && runBtn && api && toggle) {
    const rows = Array.from(panel.querySelectorAll<HTMLElement>('[data-diag-row]'));
    const vals = new Map<string, HTMLElement>();
    rows.forEach((r) => {
      const v = r.querySelector<HTMLElement>('[data-diag-val]');
      if (v) vals.set(r.dataset.diagRow ?? '', v);
    });

    let busy = false;
    let fault: (typeof FAULTS)[number] | null = null;
    let phase: 'idle' | 'fault' | 'done' = 'idle';

    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

    const reset = () => {
      rows.forEach((r) => {
        delete r.dataset.state;
        const v = r.querySelector<HTMLElement>('[data-diag-val]');
        if (v) v.textContent = '—';
      });
      cta?.setAttribute('hidden', '');
    };

    const run = async () => {
      if (busy) return;
      busy = true;
      runBtn.disabled = true;

      if (phase === 'fault' && fault) {
        runBtn.textContent = 'Устраняю…';
        api.pulse(fault.node);
        await wait(1500);
        const row = rows.find((r) => r.dataset.diagRow === fault?.row);
        if (row) row.dataset.state = 'done';
        const v = vals.get(fault.row);
        if (v) v.textContent = 'устранено';
        api.explode(false);
        phase = 'done';
        runBtn.textContent = 'Проверить ещё раз';
        runBtn.disabled = false;
        cta?.removeAttribute('hidden');
        busy = false;
        return;
      }

      reset();
      phase = 'idle';
      fault = FAULTS[Math.floor(Math.random() * FAULTS.length)] ?? null;
      runBtn.textContent = 'Идёт проверка…';
      api.explode(true);
      await wait(900);

      for (const row of rows) {
        const id = row.dataset.diagRow ?? '';
        row.dataset.state = 'active';
        const v = vals.get(id);
        if (v) v.textContent = '…';
        await wait(620);
        if (fault && id === fault.row) {
          row.dataset.state = 'warn';
          if (v) v.textContent = fault.bad;
        } else {
          row.dataset.state = 'done';
          if (v) v.textContent = OK[id] ?? 'ok';
        }
      }

      if (fault) {
        phase = 'fault';
        runBtn.textContent = 'Починить';
      } else {
        phase = 'done';
        api.explode(false);
        runBtn.textContent = 'Проверить ещё раз';
        cta?.removeAttribute('hidden');
      }
      runBtn.disabled = false;
      busy = false;
    };

    runBtn.addEventListener('click', () => {
      void run();
    });

    // кнопка оживает вместе со сценой — когда модель загрузилась
    const sync = () => {
      if (!toggle.disabled) runBtn.disabled = false;
    };
    new MutationObserver(sync).observe(toggle, { attributes: true, attributeFilter: ['disabled'] });
    sync();
  }
</script>

<style>
  .anatomy__head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .anatomy__hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
  }

  .anatomy__viewer {
    position: relative;
    margin-top: clamp(24px, 4vw, 48px);
  }

  .anatomy__stage {
    position: relative;
    height: clamp(360px, 62svh, 760px);
    overflow: hidden;
    touch-action: pan-y;
  }

  .anatomy__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(52% 60% at 50% 46%, rgba(216, 162, 74, 0.09), transparent 70%),
      radial-gradient(70% 80% at 50% 50%, rgba(18, 16, 13, 0.5), transparent 78%);
    pointer-events: none;
  }

  .anatomy__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }

  .anatomy__viewer.is-ready .anatomy__canvas {
    opacity: 1;
  }

  .anatomy__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .anatomy__labels :global(.viewer__label) {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--fg);
    text-shadow: 0 1px 12px rgba(18, 16, 13, 0.95), 0 0 3px rgba(18, 16, 13, 0.9);
    will-change: transform, opacity;
  }

  .anatomy__labels :global(.viewer__label::before) {
    content: '';
    width: 6px;
    height: 6px;
    border: 1px solid var(--accent);
    transform: rotate(45deg);
    flex: none;
  }
  .anatomy__labels :global(.viewer__leaders) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .anatomy__labels :global(.viewer__leader) {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .anatomy__labels :global(.viewer__leader-dot) {
    fill: var(--accent);
  }
  .anatomy__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 32px;
    padding-block: 18px;
    padding-inline: var(--pad);
    border-top: 1px solid var(--rule);
  }

  .anatomy__legend,
  .anatomy__hint-mono {
    color: var(--fg-muted);
  }

  .anatomy__hint-mono {
    text-align: right;
  }

  .anatomy__toggle {
    min-width: 176px;
    height: 52px;
    padding-inline: 26px;
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
  }

  .anatomy__toggle:hover:not(:disabled) {
    background: var(--accent);
    color: var(--on-accent);
  }

  .anatomy__toggle:disabled {
    opacity: 0.45;
    cursor: default;
  }

  /* --- статичный режим: нет WebGL, нет движения --- */
  .anatomy__poster {
    display: none;
  }

  .anatomy__viewer.is-static .anatomy__canvas,
  .anatomy__viewer.is-static .anatomy__labels {
    display: none;
  }

  .anatomy__viewer.is-static .anatomy__poster {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .anatomy__viewer.is-static .anatomy__stage {
    height: clamp(360px, 62svh, 620px);
  }

  .anatomy__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px 28px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .anatomy__list-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 0.9375rem;
  }

  .anatomy__list-idx {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .anatomy__bar {
      justify-content: center;
      text-align: center;
    }

    .anatomy__hint-mono {
      display: none;
    }

    .anatomy__toggle {
      width: 100%;
    }
  }
  .diag {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px max(var(--pad), calc((100% - var(--shell-max)) / 2 + var(--pad)));
    border: 1px solid var(--rule);
    background:
      linear-gradient(180deg, rgba(216, 162, 74, 0.05), transparent 62%),
      rgba(18, 16, 13, 0.55);
  }

  .diag__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }

  .diag__title {
    color: var(--fg);
    letter-spacing: 0.12em;
  }

  .diag__seq {
    color: var(--fg-muted);
    opacity: 0.7;
  }

  .diag__list {
    display: flex;
    flex-direction: column;
  }

  .diag__row {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--fg-muted);
    transition: color var(--dur-2) var(--ease-out);
  }

  .diag__row + .diag__row {
    border-top: 1px solid var(--rule);
  }

  .diag__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
    transition: opacity var(--dur-2) var(--ease-out), background var(--dur-2) var(--ease-out);
  }

  .diag__val {
    color: var(--fg);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .diag__row[data-state='active'] {
    color: var(--fg);
  }

  .diag__row[data-state='active'] .diag__dot {
    background: var(--accent);
    opacity: 1;
    box-shadow: 0 0 0 3px rgba(216, 162, 74, 0.16);
    animation: diag-pulse 1.1s var(--ease-in-out) infinite;
  }

  .diag__row[data-state='warn'] {
    color: var(--accent);
  }

  .diag__row[data-state='warn'] .diag__dot {
    background: var(--accent);
    opacity: 1;
  }

  .diag__row[data-state='done'] .diag__dot {
    background: var(--fg);
    opacity: 0.8;
  }

  @keyframes diag-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(216, 162, 74, 0.16);
    }

    50% {
      box-shadow: 0 0 0 6px rgba(216, 162, 74, 0.04);
    }
  }

  .diag__run {
    margin-top: auto;
    width: 100%;
    min-height: 44px;
    padding: 12px 16px;
    border: 0;
    background: var(--accent);
    color: var(--ink);
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background var(--dur-2) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }

  .diag__run:hover:not(:disabled) {
    background: var(--paper);
  }

  .diag__run:active:not(:disabled) {
    transform: translateY(1px);
  }

  .diag__run:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .diag__note {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--fg-muted);
    opacity: 0.8;
  }

  .diag__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
  }

  .diag__cta[hidden] {
    display: none;
  }

  .diag__cta:hover {
    color: var(--paper);
  }

  /* --- самодиагностика: полоса под сценой, сцену не сужаем --- */
  @media (min-width: 900px) {
    .diag {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr) 260px;
      align-items: start;
      column-gap: 32px;
    }

    .diag__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding-bottom: 0;
      border-bottom: 0;
    }

    .diag__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }

    .diag__note {
      display: none;
    }
  }
</style>
