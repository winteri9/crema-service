---
/**
 * Секция 04 — услуги. Источник: src/data/services.ts.
 *
 * Четыре карточки сеткой 2×2 (на мобиле в столбец): номер-индекс моно, название,
 * одна фраза. Волосяная рамка var(--rule); наведение — подъём на 2px, рамка
 * теплеет к золоту, внутри проявляется мягкая золотая подсветка из-под нижней
 * кромки. Клик не предполагается: страниц услуг у концепта нет.
 *
 * Карточка — вложенный div, а не сам li: data-reveal с его transform/transition
 * живёт на li (src/scripts/reveal.ts), и правила слоя ux.css не перебивают
 * hover-переходы карточки.
 */
import { SERVICES } from '../../data/services';
---

<section class="sec surface-ink services" id="services" aria-labelledby="services-title">
  <div class="shell sec__inner">
    <div class="sec__num">04</div>

    <div class="services__wrap">
      <div class="services__head">
        <h2 class="h2" id="services-title">Что берём на себя</h2>
        <p class="mono services__note">Полный цикл</p>
      </div>

      <ul class="services__grid">
        {
          SERVICES.map((service) => (
            <li class="services__item">
              <div class="services__card">
                <span class="mono services__n">{service.n}</span>
                <h3 class="h3 services__title">{service.title}</h3>
                <p class="services__line">{service.line}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: clamp(30px, 4.2vw, 52px);
  }

  .services__note {
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(12px, 1.4vw, 16px);
  }

  .services__item {
    display: grid;
  }

  .services__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: clamp(22px, 4.8vw, 26px);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background-color: color-mix(in srgb, var(--ink-2) 62%, transparent);
    min-height: clamp(150px, 12vw, 176px);
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  /* мягкая подсветка: свет поднимается из-под нижней кромки, не «неон» */
  .services__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      120% 120% at 50% 106%,
      color-mix(in srgb, var(--accent) 12%, transparent),
      transparent 62%
    );
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
    pointer-events: none;
  }

  .services__n {
    color: var(--fg-muted);
    transition: color var(--dur-2) var(--ease-out);
  }

  .services__title {
    margin-top: auto;
    font-size: clamp(1.25rem, 1.5vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .services__line {
    margin-top: 10px;
    max-width: 46ch;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }

  @media (hover: hover) {
    .services__card:hover {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--accent) 55%, var(--rule));
      background-color: color-mix(in srgb, var(--ink-2) 100%, transparent);
    }

    .services__card:hover::after {
      opacity: 1;
    }

    .services__card:hover .services__n {
      color: var(--accent);
    }
  }

  @media (min-width: 680px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services__card {
      min-height: clamp(168px, 11vw, 196px);
      padding: clamp(24px, 2vw, 28px);
    }
  }
</style>
