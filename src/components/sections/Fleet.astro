---
/**
 * Секция 06 — парк оборудования. Источник: src/data/fleet.ts (draft).
 *
 * Бегущая лента: два одинаковых набора карточек едут влево без конца,
 * поэтому шва не видно. Наведение и фокус внутри ленты останавливают её —
 * марку можно прочитать. При prefers-reduced-motion движение выключено,
 * а лента становится обычной горизонтальной прокруткой.
 *
 * Края растворяются маской; JS не нужен — только CSS.
 */
import { FLEET } from '../../data/fleet';

const total = String(FLEET.items.length).padStart(2, '0');
---

<section class="sec surface-ink fleet" id="fleet" aria-labelledby="fleet-title">
  <div class="shell sec__inner">
    <div class="sec__num">{FLEET.n}</div>

    <div class="fleet__head">
      <h2 class="h2" id="fleet-title">{FLEET.title}</h2>
      <p class="mono fleet__note">Парк оборудования · {total}</p>
    </div>
  </div>

  <figure class="fleet__frame">
    <div class="fleet__marquee" role="region" aria-label={`${FLEET.title}: бегущая лента марок`}>
      <div class="fleet__track" data-fleet-track>
        {
          [0, 1].map((copy) => (
            <div
              class="fleet__set"
              role={copy === 0 ? 'list' : undefined}
              aria-hidden={copy === 1 ? 'true' : undefined}
            >
              {FLEET.items.map((item, index) => (
                <div class="fleet__card" role="listitem">
                  <span class="fleet__card-num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="fleet__card-name">{item}</span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </figure>
</section>

<style>
  .fleet__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(30px, 3.6vw, 48px);
  }

  .fleet__note {
    color: var(--fg-muted);
  }

  /* --- лента: полная ширина, края растворяются --- */
  .fleet__frame {
    --fleet-fade: clamp(48px, 9vw, 150px);
    --fleet-gap: clamp(12px, 1.2vw, 18px);
    --fleet-speed: 68s;
    margin: 0;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      var(--ink) var(--fleet-fade),
      var(--ink) calc(100% - var(--fleet-fade)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      var(--ink) var(--fleet-fade),
      var(--ink) calc(100% - var(--fleet-fade)),
      transparent 100%
    );
  }

  .fleet__marquee {
    overflow: hidden;
    padding-block: 2px;
  }

  .fleet__track {
    display: flex;
    width: max-content;
    animation: fleet-run var(--fleet-speed) linear infinite;
    will-change: transform;
  }

  /* пауза там, где можно прочитать: курсор над лентой или фокус внутри */
  .fleet__marquee:hover .fleet__track,
  .fleet__marquee:focus-within .fleet__track {
    animation-play-state: paused;
  }

  @keyframes fleet-run {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* один набор: справа тот же зазор, что между карточками — стык невидим */
  .fleet__set {
    display: flex;
    gap: var(--fleet-gap);
    padding-right: var(--fleet-gap);
  }

  .fleet__card {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    width: min(360px, 78vw);
    min-height: clamp(136px, 11.5vw, 160px);
    padding: clamp(18px, 2vw, 26px);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background-color: color-mix(in srgb, var(--paper) 4%, var(--ink));
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .fleet__card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--rule));
    background-color: color-mix(in srgb, var(--paper) 6%, var(--ink));
  }

  .fleet__card-num {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .fleet__card-name {
    max-width: 15ch;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /*
   * Без анимации лента должна остаться доступной: обычный скролл.
   * Анимация выключается, набор-дубль прячется — иначе он просто копия.
   */
  @media (prefers-reduced-motion: reduce) {
    .fleet__marquee {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      padding-left: var(--pad);
      scrollbar-width: none;
    }

    .fleet__marquee::-webkit-scrollbar {
      display: none;
    }

    .fleet__track {
      animation: none;
    }

    .fleet__set[aria-hidden='true'] {
      display: none;
    }
  }
</style>
