---
/**
 * Стрелка в ссылках и кнопках. Рисуем SVG, а не глиф «↗»:
 * стрелки нет в сабсете шрифта, а системный глиф ломает ритм строки.
 */
interface Props {
  /** длина штриха: 18 по умолчанию, 24 — в крупных ссылках */
  size?: number;
  class?: string;
}

const { size = 18, class: className = '' } = Astro.props;
---

<svg
  class:list={['arrow', className]}
  width={size}
  height={size * 0.67}
  viewBox="0 0 18 12"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path d="M1 6h15M11 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
</svg>
