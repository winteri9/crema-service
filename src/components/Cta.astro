---
/**
 * Кнопка-ссылка. Одна геометрия, три инверсии: акцент на тёмном,
 * инверсия (bg/fg) на светлой карточке и контурная.
 * Высота от 56px: палец на мобиле попадает без прицела.
 *
 * Характер: волосяная рамка снаружи (стоит на 4px, расходится на hover),
 * подъём на 2px и тень. Рамка в цвет currentColor — сама подстраивается
 * под инверсию, поэтому вариант не надо переписывать под каждую поверхность.
 */
import Arrow from './Arrow.astro';

interface Props {
  href: string;
  label: string;
  variant?: 'solid' | 'invert' | 'outline';
  external?: boolean;
  size?: 'md' | 'lg';
}

const { href, label, variant = 'solid', external = false, size = 'md' } = Astro.props;
---

<a
  class:list={['cta', `cta--${variant}`, `cta--${size}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="cta__label">{label}</span>
  <Arrow size={size === 'lg' ? 20 : 18} class="cta__arrow" />
</a>

<style>
  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 56px;
    padding: 0 26px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-l);
    font-weight: 500;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transform: translate3d(0, 0, 0);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .cta--lg {
    min-height: 64px;
    padding: 0 34px;
  }

  /* --- волосяная рамка снаружи --- */
  .cta::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    border-radius: var(--radius);
    opacity: 0.55;
    pointer-events: none;
    transition:
      inset var(--dur-2) var(--ease-out),
      opacity var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .cta:hover::after,
  .cta:focus-visible::after {
    inset: -7px;
    opacity: 1;
  }

  .cta:focus-visible {
    outline-offset: 8px;
  }

  /* --- подъём и тень: только там, где есть курсор --- */
  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 30px -20px color-mix(in srgb, var(--ink) 75%, transparent);
    }
  }

  .cta:focus-visible {
    transform: translateY(-2px);
  }

  .cta:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .cta__arrow {
    flex: none;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .cta:hover .cta__arrow,
  .cta:focus-visible .cta__arrow {
    transform: translateX(3px);
  }

  .cta--solid {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  /* на золоте рамка — золото: на тёмном фоне иначе не читается */
  .cta--solid::after {
    border-color: color-mix(in srgb, var(--accent) 34%, transparent);
  }

  .cta--solid:hover,
  .cta--solid:focus-visible {
    background: transparent;
    color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta--solid:hover {
      box-shadow: 0 16px 34px -20px color-mix(in srgb, var(--accent) 65%, transparent);
    }
  }

  .cta--solid:focus-visible {
    box-shadow: 0 16px 34px -20px color-mix(in srgb, var(--accent) 65%, transparent);
  }

  .cta--invert {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  /* на бумаге рамка в цвет текста: в тексте кнопки бумага была бы невидимой */
  .cta--invert::after {
    border-color: color-mix(in srgb, var(--fg) 24%, transparent);
  }

  .cta--invert:hover,
  .cta--invert:focus-visible {
    background: transparent;
    color: var(--fg);
  }

  .cta--outline {
    border-color: var(--rule);
    color: var(--fg);
  }

  .cta--outline:hover,
  .cta--outline:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cta--outline:hover::after,
  .cta--outline:focus-visible::after {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
</style>
