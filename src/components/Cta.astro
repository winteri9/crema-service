---
/**
 * Кнопка-ссылка. Одна геометрия, три инверсии: акцент на тёмном,
 * инверсия (bg/fg) на светлой карточке и контурная.
 * Высота и паддинги — от 52px: палец на мобиле попадает без прицела.
 */
import Arrow from './Arrow.astro';

interface Props {
  href: string;
  label: string;
  variant?: 'solid' | 'invert' | 'outline';
  external?: boolean;
  size?: 'md' | 'lg';
}

const { href, label, variant = 'solid', external = false, size = 'md' } = Astro.props;
---

<a
  class:list={['cta', `cta--${variant}`, `cta--${size}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="cta__label">{label}</span>
  <Arrow size={size === 'lg' ? 20 : 18} class="cta__arrow" />
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 52px;
    padding: 0 24px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-l);
    font-weight: 500;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .cta--lg {
    min-height: 60px;
    padding: 0 30px;
  }

  .cta__arrow {
    flex: none;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .cta:hover .cta__arrow,
  .cta:focus-visible .cta__arrow {
    transform: translateX(3px);
  }

  .cta--solid {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .cta--solid:hover,
  .cta--solid:focus-visible {
    background: transparent;
    color: var(--accent);
  }

  .cta--invert {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .cta--invert:hover,
  .cta--invert:focus-visible {
    background: transparent;
    color: var(--fg);
  }

  .cta--outline {
    border-color: var(--rule);
    color: var(--fg);
  }

  .cta--outline:hover,
  .cta--outline:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
